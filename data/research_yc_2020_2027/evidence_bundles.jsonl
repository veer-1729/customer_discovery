en source components from SONiC, FRR, and related networking stacks.","raw_cache_path":null,"fetched_at":"2026-05-18T21:03:45.982893Z","success":true,"error":null,"metadata":{"query_used":"Eos AI site:ashbyhq.com","search_provider":"tavily"}},{"id":"ev_c77ff17b1f09","company_id":"helloeos-ai","source_type":"search_result","url":"https://jobs.ashbyhq.com/mithrl/c13e4ed4-cea2-4283-b5c2-f85456d47c22","title":"Design Technologist @ Mithrl - Jobs","text_snippet":"Mithrl is building the world's first commercially available AI Co-Scientist for drug discovery. Our platform transforms messy biological data into insights in","raw_cache_path":null,"fetched_at":"2026-05-18T21:03:45.982901Z","success":true,"error":null,"metadata":{"query_used":"Eos AI site:ashbyhq.com","search_provider":"tavily"}},{"id":"ev_82910ba394e8","company_id":"helloeos-ai","source_type":"careers","url":"https://jobs.ashbyhq.com/Crusoe/d472048d-856d-444d-9fff-cf052fe2a184","title":"Asset Manager, Supply Chain @ Crusoe","text_snippet":"Asset Manager, Supply Chain @ Crusoe","raw_cache_path":"/Users/veer/Documents/StartUp/customer_discovery/data/raw/research/helloeos-ai/21582be90ddb7550.html","fetched_at":"2026-05-18T21:03:46.290656Z","success":true,"error":null,"metadata":{"discovered_via":"search","query_used":"Eos AI site:ashbyhq.com"}}],"coverage":{"homepage_found":true,"careers_found":true,"docs_found":false,"status_found":false,"blog_or_changelog_found":false,"github_found":false,"seed_metadata_found":true,"fallback_search_used":true,"total_successful_sources":4,"source_diversity_score":0.375,"confidence_cap":"high"},"trace":{"probes_attempted":["seed_metadata","homepage","known_links","careers","docs","status","blog_changelog","github","agent_search_fallback"],"urls_attempted":["https://www.ycombinator.com/companies/eos-ai","https://www.helloeos.ai","https://jobs.ashbyhq.com/Crusoe/d472048d-856d-444d-9fff-cf052fe2a184","https://jobs.ashbyhq.com/panoptyc/155e56f1-4eaa-4a53-86ba-f466a414578e","https://j