# Copy to .env and fill in values (never commit .env)
# cp .env.example .env

# --- Required for Part 2 (research) and Part 3 (outreach) LLM stages ---
OPENAI_API_KEY=

# --- Optional: web search fallback (config/research.yaml → search.provider) ---
# Needed only when careers/path probes fail and agent-wide search runs.
# If unset, search is disabled automatically with a warning.
TAVILY_API_KEY=

# Alternative search providers (uncomment the pair you use and set search.provider in config/research.yaml)
# SERPAPI_API_KEY=
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# --- Optional: CMU source via Airtable API (CSV export works without this) ---
# AIRTABLE_API_KEY=
