# Copy to .env and fill in values (never commit .env)
# cp .env.example .env

# --- Required for Part 2 (research) and Part 3 (outreach) LLM stages ---
OPENAI_API_KEY=

# --- Web search (research evidence collection) ---
# Primary: Tavily; fallback: SerpAPI (see config/research.yaml fallback_providers)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Other search providers (optional; set search.provider in config/research.yaml)
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# --- Optional: CMU source via Airtable API (CSV export works without this) ---
# AIRTABLE_API_KEY=
